{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/journey.html", "destination": "/journey", "permanent": true },
    { "source": "/limits.html", "destination": "/limits", "permanent": true },
    { "source": "/memory.html", "destination": "/memory", "permanent": true },
    { "source": "/method.html", "destination": "/method", "permanent": true },
    { "source": "/milestones.html", "destination": "/milestones", "permanent": true },
    { "source": "/proof.html", "destination": "/proof", "permanent": true },
    { "source": "/results.html", "destination": "/results", "permanent": true },
    { "source": "/tasks.html", "destination": "/tasks", "permanent": true }
  ],
  "rewrites": [
    { "source": "/journey", "destination": "/journey.html" },
    { "source": "/limits", "destination": "/limits.html" },
    { "source": "/memory", "destination": "/memory.html" },
    { "source": "/method", "destination": "/method.html" },
    { "source": "/milestones", "destination": "/milestones.html" },
    { "source": "/proof", "destination": "/proof.html" },
    { "source": "/results", "destination": "/results.html" },
    { "source": "/tasks", "destination": "/tasks.html" }
  ]
}
